# Environment Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://flashcard_user:flashcard_password@postgres:5432/flashcard_db
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flashcard_db
DB_USER=flashcard_user
DB_PASSWORD=flashcard_password

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security
BCRYPT_ROUNDS=12

# Features
ENABLE_REGISTRATION=true
ENABLE_ADMIN_ROUTES=true
MAX_UPLOAD_SIZE=10485760

# Spaced Repetition Configuration
DEFAULT_MASTERY_THRESHOLD=3
DEFAULT_INITIAL_SUBSET=10
DEFAULT_STEP_SIZE=10
DEFAULT_EASE_FACTOR=2.5

# Gamification
ENABLE_GAMIFICATION=true
ENABLE_LEADERBOARDS=true
