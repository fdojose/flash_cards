# Phase 8.2: Production Environment Configuration
# ==============================================
# Production environment variables for Docker deployment

# Database Configuration
POSTGRES_DB=flashcard_production
POSTGRES_USER=flashcard_user
POSTGRES_PASSWORD=your-super-secure-database-password-change-me
DATABASE_URL=postgresql://flashcard_user:your-super-secure-database-password-change-me@postgres:5432/flashcard_production

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# Environment
ENVIRONMENT=production
DEBUG=false

# Logging
LOG_LEVEL=INFO

# Redis Configuration
REDIS_PASSWORD=your-redis-password-change-me
REDIS_URL=redis://:your-redis-password-change-me@redis:6379/0

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-admin-password

# Frontend
REACT_APP_API_URL=https://yourdomain.com/api
REACT_APP_ENVIRONMENT=production

# SSL Certificate paths (if using custom certificates)
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/certs/server.key

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@yourdomain.com

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=/app/uploads

# Session Configuration
SESSION_TIMEOUT=86400  # 24 hours in seconds

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# Performance Settings
WORKERS=4
MAX_CONNECTIONS=1000
KEEPALIVE_TIMEOUT=65

# Security Headers
SECURITY_HEADERS_ENABLED=true
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
